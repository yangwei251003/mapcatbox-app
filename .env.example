# Public Pages and local default: keep false. Never put real private values in source.
NEXT_PUBLIC_CLOUD_MODE=false
NEXT_PUBLIC_ALLOW_DEVICE_LOCATION=false
NEXT_PUBLIC_BASE_PATH=
# Personal cloud instance only, copied to ignored .env.local; these are NOT server secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
